# Domain, unter der der Editor via Traefik erreichbar sein soll
EDITOR_HOST=editor.example.com

# Host-Verzeichnis, das im Container unter /files eingebunden wird
HOST_DATA_DIR=./data

# UID/GID, unter der der Editor im Container auf das Dateisystem zugreift.
# Muss zu den Besitzrechten von HOST_DATA_DIR passen (z. B. "id -u"/"id -g" des
# Host-Nutzers, dem das Verzeichnis gehört).
PUID=1000
PGID=1000

# Name des externen Traefik-Docker-Netzwerks
TRAEFIK_NETWORK=traefik

# Nur Mitglieder dieser Remote-Group (aus dem Forward-Auth-Header) dürfen zugreifen.
# Leer lassen, um jedem authentifizierten Nutzer Zugriff zu geben.
AUTH_ALLOWED_GROUP=

# Image/Tag, das docker compose verwendet (Standard: das zuletzt via CI auf GHCR
# veröffentlichte Image). Für einen lokal per "make build" gebauten Stand muss
# hier nichts geändert werden, docker compose nutzt dann automatisch das lokale Image.
#EDITOR_IMAGE=ghcr.io/hengeb/editor
#EDITOR_TAG=latest
